# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL) ----
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://bimaya:bimaya_dev_pw@localhost:5432/bimaya

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Email ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Bimaya <no-reply@bimaya.local>

# ---- Payment gateways (sandbox in dev; real merchant keys at launch) ----
# ESEWA_MERCHANT_CODE=
# ESEWA_SECRET_KEY=
# KHALTI_SECRET_KEY=
