# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL) ----
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://bimaya:bimaya_dev_pw@localhost:5432/bimaya

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Email ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Bimaya <no-reply@bimaya.local>

# ---- One-time passwords (account verification & password reset) ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Returns the code in the API response so signup can be completed without an
# SMS/email gateway. Defaults to DJANGO_DEBUG — must be False in production.
OTP_RETURN_IN_RESPONSE=True

# ---- Payment gateways (sandbox in dev; real merchant keys at launch) ----
# ESEWA_MERCHANT_CODE=
# ESEWA_SECRET_KEY=
# KHALTI_SECRET_KEY=
