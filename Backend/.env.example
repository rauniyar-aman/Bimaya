# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL) ----
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://bimaya:bimaya_dev_pw@localhost:5432/bimaya

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Email ----
# Dev default: the console backend prints OTP codes + notification emails to the
# server log (and the OTP is also returned in the API response — see
# OTP_RETURN_IN_RESPONSE below), so signup works with no setup. To send REAL
# email, set EMAIL_HOST and the matching credentials — this switches the default
# mailer to SMTP automatically. Any SMTP provider works; a couple of examples:
#
#   Gmail — use a 16-character App Password, NOT your normal password
#   (create one at https://myaccount.google.com/apppasswords):
#     EMAIL_HOST=smtp.gmail.com
#     EMAIL_PORT=587
#     EMAIL_HOST_USER=you@gmail.com
#     EMAIL_HOST_PASSWORD=your-16-char-app-password
#     EMAIL_USE_TLS=True
#     DEFAULT_FROM_EMAIL=Bimaya <you@gmail.com>
#
#   Transactional provider (Brevo / SendGrid / Mailgun / Resend) — better
#   deliverability; use the SMTP login + key from your provider dashboard:
#     EMAIL_HOST=smtp-relay.brevo.com     # or smtp.sendgrid.net, smtp.resend.com, …
#     EMAIL_PORT=587
#     EMAIL_HOST_USER=your-smtp-login
#     EMAIL_HOST_PASSWORD=your-smtp-key
#     EMAIL_USE_TLS=True
#     DEFAULT_FROM_EMAIL=Bimaya <no-reply@your-verified-domain>
#
# Uncomment and fill these to go live:
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False        # use SSL instead of TLS (port 465) — never set both True
# EMAIL_TIMEOUT=15
# Advanced: override the backend directly (defaults to console when EMAIL_HOST is unset).
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# The "From" address on every email. For Gmail this must match EMAIL_HOST_USER;
# for a transactional provider use a verified sender on your own domain.
DEFAULT_FROM_EMAIL=Bimaya <no-reply@bimaya.local>

# ---- One-time passwords (account verification & password reset) ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Returns the code in the API response so signup can be completed without an
# SMS/email gateway. Defaults to DJANGO_DEBUG — must be False in production.
OTP_RETURN_IN_RESPONSE=True

# ---- Payment gateways (sandbox in dev; real merchant keys at launch) ----
# Unset values default to the gateways' own public sandbox test credentials —
# see apps/payments/gateways/. Set real values in production only.
# ESEWA_MERCHANT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# KHALTI_SECRET_KEY=test_secret_key_68ba473c2ce54774bee9d4791cf34c1c

# ---- AI chat assistant ----
# Rule-based policy recommendations are always on. The free-form chat assistant
# calls an external LLM and stays off until you enable it and set a key.
# AI_CHAT_ENABLED=False
# AI_CHAT_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# ---- Web Push (browser notifications) ----
# In-app + email notifications are always on. Browser push stays off until you
# enable it AND set a VAPID keypair (generate one with `vapid --gen`, from the
# py-vapid package pulled in by pywebpush). The private key MUST stay here on the
# server; expose only the public key to the frontend as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# NOTIFICATIONS_PUSH_ENABLED=False
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=admin@bimaya.local

# ---- Government insurance registry sync ----
# Reporting issued policies to a central regulator is scaffolded but off. It only
# runs via the `sync_gov_registry` management command, and only when enabled with
# an endpoint and key set. Only non-PII regulatory metadata is ever sent (policy
# numbers, plan/provider identifiers, amounts) — never customer identity or KYC.
# GOV_INTEGRATION_ENABLED=False
# GOV_INTEGRATION_ENDPOINT=
# GOV_INTEGRATION_API_KEY=
